{
  "name": "@chubbyts/chubbyts-undici-server-uwebsockets",
  "type": "module",
  "version": "1.1.0",
  "description": "Use @chubbyts/chubbyts-undici-server on uwebsockets.",
  "keywords": [],
  "author": "Dominik Zogg",
  "license": "MIT",
  "repository": "chubbyts/chubbyts-undici-server-uwebsockets",
  "scripts": {
    "build": "tsc",
    "cs-fix": "prettier --write src tests",
    "cs": "prettier --check src tests",
    "infection": "stryker run",
    "lint-fix": "eslint src tests eslint.config.js vitest.config.ts --fix",
    "lint": "eslint src tests",
    "prepare": "pnpm run build",
    "test": "vitest",
    "test:integration": "vitest --config vitest.integration.config.js"
  },
  "prettier": {
    "printWidth": 120,
    "tabWidth": 2,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./*": {
      "types": "./*.d.ts",
      "import": "./*.js",
      "default": "./*.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@chubbyts/chubbyts-undici-server": "^1.1.0",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.61.0"
  },
  "devDependencies": {
    "@chubbyts/chubbyts-eslint": "^5.0.0",
    "@stryker-mutator/core": "^9.6.0",
    "@stryker-mutator/vitest-runner": "^9.6.0",
    "@types/node": "^25.5.2",
    "@vitest/coverage-v8": "^4.1.2",
    "cross-fetch": "^4.1.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
